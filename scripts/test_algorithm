#!/usr/bin/env python3

import argparse
import json
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

if (CPU_ARCH := platform.machine().lower()) in ["x86_64", "amd64"]:
    CPU_ARCH = "amd64"
elif CPU_ARCH in ["arm64", "aarch64"]:
    CPU_ARCH = "arm64"
else:
    print(f"Unsupported CPU architecture: {CPU_ARCH}")
    sys.exit(1)

HAS_GPU = subprocess.run(["which", "nvidia-smi"], capture_output=True).returncode == 0
if (VISIBLE_CPUS := os.environ.get("CPU_VISIBLE_CORES", None)) is None:
    VISIBLE_CPUS = list(os.sched_getaffinity(0))
else:
    VISIBLE_CPUS = list(map(int, VISIBLE_CPUS.split(",")))
    os.sched_setaffinity(0, VISIBLE_CPUS)

if not HAS_GPU:
    VISIBLE_GPUS = []
elif (VISIBLE_GPUS := os.environ.get("CUDA_VISIBLE_DEVICES", None)) is None:
    VISIBLE_GPUS = [
        int(match.group(1))
        for line in subprocess.check_output(["nvidia-smi", "-L"]).decode("utf-8").splitlines()
        if (match := re.match(r'^GPU (\d+):', line)) is not None
    ]
else:
    VISIBLE_GPUS = list(map(int, VISIBLE_GPUS.split(",")))

CHALLENGE = os.getenv("CHALLENGE")
if CHALLENGE is None:
    print("CHALLENGE environment variable must be set!")
    sys.exit(1)

# Fraction of --fuel handed to the index build when the algorithm builds one.
# Provisional: Task 8 of docs/superpowers/plans/2026-08-31-c004-index-build-split-monorepo.md
# measures the real value. It is a separate budget, not a slice taken out of
# --fuel: the query phase still gets the whole of --fuel.
BUILD_FUEL_ALPHA = 0.25


def now():
    return int(time.time() * 1000)


def exports_index_abi(so_path):
    """True when the algorithm exports both halves of the index-build ABI.

    Read out of the binary rather than taken from a flag, because the ~90
    existing c004 algorithms export neither symbol and `tig-runtime build-index`
    errors out on them. Detecting it here keeps every one of those algorithms on
    exactly the command line it has today.

    Both symbols are required, not either: `load_index` alone cannot produce an
    index, and tig-runtime refuses a `build_index` that has no `load_index` to
    read the blob back.
    """
    try:
        out = subprocess.check_output(
            ["nm", "-D", "--defined-only", so_path], text=True, stderr=subprocess.DEVNULL
        )
    except Exception:
        # No nm, or an unreadable .so. Treat as "no index ABI" so the algorithm
        # runs the way it does today rather than failing on a detection problem.
        return False
    symbols = {line.split()[-1] for line in out.splitlines() if line.strip()}
    return "build_index" in symbols and "load_index" in symbols


if __name__ == "__main__":
    tig_runtime_path = shutil.which("tig-runtime")
    tig_verifier_path = shutil.which("tig-verifier")
    parser = argparse.ArgumentParser(description="TIG Algorithm Tester")
    parser.add_argument("algorithm", type=str, help="Algorithm name")
    parser.add_argument("track_id", type=str, help="Track Id of the problem instance, comma separated key-values (e.g. a=1,b=2)")
    parser.add_argument("hyperparameters", type=str, help="JSON string of hyperparameters for the algorithm (can set to null)")
    parser.add_argument("--tig-runtime-path", type=str, default=tig_runtime_path, help=f"Path to tig-runtime executable (default: {tig_runtime_path})")
    parser.add_argument("--tig-verifier-path", type=str, default=tig_verifier_path, help=f"Path to tig-verifier executable (default: {tig_verifier_path})")
    parser.add_argument("--lib-dir", type=str, default="./tig-algorithms/lib", help="Path to the algorithms library folder (default: ./tig-algorithms/lib)")
    parser.add_argument("--seed", type=str, default="rand_hash", help="String to use as seed instance generation (default: 'rand_hash')")
    parser.add_argument("--start", type=int, default=0, help="Starting nonce (default: 0)")
    parser.add_argument("--nonces", type=int, default=100, help="Number of nonces to process (default: 100)")
    parser.add_argument("--fuel", type=int, default=int(100e9), help="Max fuel (default: 100 billion)")
    parser.add_argument("--workers", type=int, default=1, help="Number of worker threads (default: 1)")
    parser.add_argument("--audit-salt", type=str, default=None, help="32-byte audit salt as 64 hex chars, passed to tig-verifier (default: all-zeros)")
    parser.add_argument("--ignore-invalid", action='store_true', help="Continue testing even if invalid solutions are encountered")
    parser.add_argument("--build-fuel", type=int, default=None, help=f"Fuel budget for the index build phase (default: {BUILD_FUEL_ALPHA} x --fuel)")
    parser.add_argument("--build-timeout", type=int, default=None, help="Wall-clock watchdog for the index build, in seconds (default: tig-runtime's own)")
    parser.add_argument("--memory-cap", type=int, default=None, help="Device memory the index build may use, in bytes (default: tig-runtime's own)")
    parser.add_argument("--no-index-build", action='store_true', help="Never build an index, even if the algorithm exports the index ABI")
    parser.add_argument("--verbose", action='store_true', help="Print debug logs")
    
    args = parser.parse_args()
    if args.hyperparameters.lower() == "null":
        args.hyperparameters = None
    else:
        try:
            json.loads(args.hyperparameters)
        except Exception as e:
            print(f"Failed to parse hyperparameters as JSON: {e}")
            sys.exit(1)
    
    so_path = f"{args.lib_dir}/{CHALLENGE}/{CPU_ARCH}/{args.algorithm}.so"
    ptx_path = f"{args.lib_dir}/{CHALLENGE}/ptx/{args.algorithm}.ptx"

    if not os.path.exists(so_path):
        print(
f"""Library not found at {so_path}:
    * To download: use download_algorithm
    * To build: use build_algorithm
    * To set the lib folder: set --lib-dir <path_to_folder>
""")
        sys.exit(1)

    if not os.path.exists(ptx_path):
        ptx_path = None
    elif not HAS_GPU:
        print(f"PTX file found at {ptx_path}, but no GPU support detected (failed to run nvidia-smi)")
        sys.exit(1)

    challenge_ids = {
        "satisfiability": "c001",
        "vehicle_routing": "c002",
        "knapsack": "c003",
        "vector_search": "c004",
        "hypergraph": "c005",
        "neuralnet_optimizer": "c006",
        "job_scheduling": "c007",
        "energy_arbitrage": "c008",
    }
    challenge_id = challenge_ids[CHALLENGE]

    settings = {"algorithm_id": "", "challenge_id": challenge_id, "track_id": args.track_id, "block_id": "", "player_id": ""}

    # Build the index once, before any nonce runs.
    #
    # This is the whole point of the phase split: the build is charged its own
    # `--build-fuel` budget and its wall clock is reported separately, so it
    # lands in NO nonce's `elapsed`. An index-building method is therefore
    # measured on its query cost, the way it would be in production where one
    # build is amortised over a whole bundle.
    #
    # Gated on c004 because `tig-runtime build-index` is `#[cfg(feature = c004)]`
    # -- on any other challenge it exits 84 rather than doing anything, and a
    # stray symbol match would turn that into a spurious run failure.
    index_path = None
    if (
        challenge_id == "c004"
        and ptx_path is not None
        and not args.no_index_build
        and exports_index_abi(so_path)
    ):
        build_fuel = args.build_fuel if args.build_fuel is not None else int(BUILD_FUEL_ALPHA * args.fuel)
        index_dir = tempfile.mkdtemp(prefix="tig_index_")
        index_path = os.path.join(index_dir, "index.blob")
        build_cmd = [
            args.tig_runtime_path,
            "build-index",
            json.dumps(settings, separators=(',',':')),
            args.seed,
            so_path,
            "--build-fuel", str(build_fuel),
            "--index-out", index_path,
            "--ptx", ptx_path,
            "--gpu", "0",
        ]
        if args.build_timeout is not None:
            build_cmd += ["--build-timeout", str(args.build_timeout)]
        if args.memory_cap is not None:
            build_cmd += ["--memory-cap", str(args.memory_cap)]
        if args.hyperparameters:
            build_cmd += ["--hyperparameters", args.hyperparameters]
        if args.verbose:
            printable = build_cmd[:2] + ["'" + build_cmd[2] + "'"] + build_cmd[3:]
            print("[build-index] " + " ".join(printable))
        build_start = now()
        build_ret = subprocess.run(build_cmd, capture_output=True, text=True)
        build_ms = now() - build_start
        if build_ret.returncode != 0:
            # Fatal, never a silent fall back to running without an index: the
            # algorithm declared the ABI, so its `entry_point` is entitled to
            # assume `load_index` already ran. Solving without one would either
            # crash or quietly produce a worse answer, and the run would report
            # that as the algorithm's real score.
            rc = build_ret.returncode
            hint = ""
            if rc < 0:
                # subprocess encodes death by signal as a NEGATIVE returncode.
                # Printed raw it reads as an ordinary non-zero exit, and a
                # killed child writes no stderr -- so the reader gets
                # "exit -9" and an empty message and debugs the algorithm.
                # Measured 2026-09-01: that is exactly what happened, twice,
                # and the agent rewrote a correct IVF in response.
                try:
                    why = f"killed by signal {-rc} ({signal.Signals(-rc).name})"
                except ValueError:
                    # A number this platform does not name. Still say the
                    # number: raising here would replace a diagnosable
                    # failure with a traceback.
                    why = f"killed by signal {-rc}"
                # Say where to look, since there is no stderr to read.
                hint = ("  (a killed build produces no stderr; if this box runs "
                        "the gpuq runner, check its orphan sweep in the runner log)")
            else:
                why = f"exit {rc}"
            print(f"build-index failed ({why}) after {build_ms}ms")
            if hint:
                print(hint)
            print(build_ret.stderr.strip())
            sys.exit(1)
        print(f"index built in {build_ms}ms, {os.path.getsize(index_path)} bytes "
              f"(not counted in any nonce's elapsed)")
        if args.verbose and build_ret.stderr.strip():
            print(f"[build-index] {build_ret.stderr.strip()}")

    pool = ThreadPoolExecutor(max_workers=args.workers + 1)

    results = {}
    def print_results():
        start = now()
        while True:
            time.sleep(0.5)
            num_processing, num_finished, num_invalid = 0, 0, 0
            total_quality = 0
            for (_, _, ok, quality) in results.values():
                if ok is None:
                    num_processing += 1
                elif ok:
                    num_finished += 1
                    total_quality += quality
                else:
                    num_invalid += 1
            
            elapsed = (now() - start) / 1000
            avg_quality = (total_quality // num_finished) if num_finished > 0 else 0
            out = f"#processing: {num_processing}, #finished: {num_finished}, #invalid: {num_invalid}, elapsed: {elapsed:.2f}s, avg_quality: {avg_quality:,}       "
            if args.verbose:
                print(out)
            else:
                print(f"\r{out}", end="")
            
            if (num_finished + num_invalid) == args.nonces:
                if num_invalid > 0:
                    print()
                    print("Warning: Invalid solutions encountered. This will cause actual benchmarks to fail.")
                break
            if num_invalid > 0 and not args.ignore_invalid:
                print()
                print("Invalid solution encountered. Stopping tests")
                print("To continue testing despite invalid solutions, use the --ignore-invalid flag.")
                print("Warning: Invalid solutions will cause actual benchmarks to fail.")
                break
        if not args.verbose:
            print("\n")

    def run_tig_runtime(nonce):
        with tempfile.TemporaryDirectory() as temp_dir:
            cmd = [
                args.tig_runtime_path,
                json.dumps(settings, separators=(',',':')),
                args.seed,
                str(nonce),
                so_path,
                "--fuel", str(args.fuel),
                "--output", temp_dir,
            ]
            if ptx_path is not None:
                cmd += [
                    "--ptx", ptx_path,
                    "--gpu", str(nonce % len(VISIBLE_GPUS)),
                ]
            if index_path is not None:
                # `load_index` runs inside this process, so its wall clock IS in
                # this nonce's elapsed -- only the build itself was hoisted out.
                # With c004 at one nonce per score that is the honest number; a
                # real bundle would amortise the load over every nonce too.
                cmd += ["--index", index_path]
            if args.hyperparameters:
                cmd += [
                    "--hyperparameters", args.hyperparameters,
                ]
            if args.verbose:
                print(f"[nonce {nonce}]: {' '.join(cmd[:1] + [f"'{cmd[1]}'"] + cmd[2:])}")
            start = now()
            results[nonce] = (start, None, None, None)
            ret = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, universal_newlines=True)
            for line in ret.stdout:
                if args.verbose:
                    print(f"[nonce {nonce}] {line.strip()}")
            ret.wait()
            elapsed = now() - start
            output_file = f"{temp_dir}/{nonce}.json"
            elapsed2 = 0

            cmd2 = [
                args.tig_verifier_path,
                json.dumps(settings, separators=(',',':')),
                args.seed,
                str(nonce),
                output_file,
            ]
            if ptx_path is not None:
                cmd2 += [
                    "--ptx", ptx_path,
                    "--gpu", str(nonce % len(VISIBLE_GPUS)),
                ]
            if args.audit_salt is not None:
                cmd2 += ["--audit-salt", args.audit_salt]
            if args.verbose:
                cmd2 += ["--verbose"]
                print(f"[nonce {nonce}] {' '.join(cmd2[:1] + [f"'{cmd2[1]}'"] + cmd2[2:])}")
            ret2 = subprocess.Popen(cmd2, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, universal_newlines=True)
            for line in ret2.stdout:
                if args.verbose:
                    print(f"[nonce {nonce}] {line.strip()}")
            ret2.wait()
            elapsed2 = now() - start - elapsed

            if args.verbose:
                out = f"[nonce {nonce}] finished\n\ttig-runtime\n\t\telapsed: {elapsed}ms\n\t\texit code: {ret.returncode}\n\t\tstderr: "
                if ret.returncode != 0:
                    if ret.returncode == 87:
                        out += "out of fuel"
                    else:
                        out += ret.stderr.read()
                out += f"\n\ttig-verifier\n\t\telapsed: {elapsed2}ms\n\t\texit code: {ret2.returncode}\n\t\tstderr: "
                if ret2.returncode != 0:
                    out += ret2.stderr.read()
                print(out)
            ok = ret2.returncode == 0
            quality = None
            if ok:
                line = line.strip()
                assert line.startswith("quality: ")
                quality = int(line[len("quality: "):])
            results[nonce] = (start, elapsed, ok, quality)
            if not ok and not args.ignore_invalid:
                raise RuntimeError

    nonces = list(range(args.start, args.start + args.nonces))
    if args.verbose:
        print(f"Processing {len(nonces)} nonces with {args.workers} workers...")
    pool.submit(print_results)
    try:
        list(pool.map(run_tig_runtime, nonces))
    except RuntimeError as e:
        pass
    finally:
        # mkdtemp, not TemporaryDirectory: the index has to outlive the build
        # subprocess and every nonce that loads it, so it cannot be scoped to a
        # `with` around either one.
        if index_path is not None:
            shutil.rmtree(os.path.dirname(index_path), ignore_errors=True)